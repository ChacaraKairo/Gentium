{
  "expo": {
    "name": "Gentium",
    "slug": "gentium",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F7F4ED"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "5",
      "supportsTablet": true,
      "bundleIdentifier": "com.gentium.app"
    },
    "android": {
      "allowBackup": false,
      "package": "com.gentium.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7F4ED"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "4617c171-58c1-4ca4-be89-95c16003d7fa"
      }
    }
  }
}
