{
  "expo": {
    "name": "Gentium",
    "slug": "gentium",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F7F4ED"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "3",
      "supportsTablet": true,
      "bundleIdentifier": "com.gentium.app"
    },
    "android": {
      "package": "com.gentium.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#F7F4ED"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-sqlite"
    ]
  }
}
