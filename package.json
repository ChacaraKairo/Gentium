{
  "name": "gentium",
  "version": "1.4.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node scripts/validate-v14.js",
    "validate:production": "npm test && npx expo install --check && node scripts/validate-production.js",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:playstore": "eas build --platform android --profile production",
    "submit:android:playstore": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/native": "^7.3.4",
    "expo": "~54.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-font": "14.0.12",
    "expo-localization": "~17.0.9",
    "expo-sqlite": "~16.0.10",
    "i18next": "^25.7.3",
    "react": "19.1.0",
    "react-i18next": "^16.4.1",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.11",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "expo-font": "14.0.12"
  }
}
